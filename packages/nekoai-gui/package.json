{
  "name": "nekoai-gui",
  "description": "Cordis WebUI for NovelAI via nekoai-js",
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./http": "./src/http.ts",
    "./src/*": "./src/*",
    "./client/*": "./client/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "dist",
    "client"
  ],
  "cordis": {
    "public": [
      "dist"
    ],
    "description": {
      "en": "NovelAI image, director and text GUI",
      "zh": "NovelAI 绘图、Director 与文本生成界面"
    },
    "service": {
      "required": [
        "webui",
        "server"
      ]
    }
  },
  "peerDependencies": {
    "@cordisjs/plugin-server": "^1.7.0",
    "@cordisjs/plugin-webui": "^0.8.1",
    "cordis": "^4.0.0-rc.5"
  },
  "devDependencies": {
    "@cordisjs/client": "^0.8.2",
    "@cordisjs/plugin-server": "^1.7.0",
    "@cordisjs/plugin-webui": "^0.8.2",
    "cordis": "^4.0.0-rc.7",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "cosmokit": "^1.8.1",
    "nekoai-js": "^1.3.0",
    "schemastery": "^3.18.0"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  }
}
